<?php

/** @var OrderView $block */

use Syedzaidi\JetIntegration\Block\OrderView;


echo <<<TAG
<div data-mage-init='{
    "collapsible":{
        "collapsible": true,
        "openedState": "active",
        "active": false
    }}' class="fieldset-wrapper admin__collapsible-block-wrapper">
    <div data-role="title" class="admin__collapsible-title">
        <h4>Realtime Jet Order Data</h4>
    </div>
    <div data-role="content">
TAG;

$singleOrder = $block->jetOrderView();

if (is_array($singleOrder) && count($singleOrder)) {
    if ($singleOrder['jet_request_directed_cancel'] === true) {
        echo "<b>This order was canceled</b>";
    }
    echo "<pre>".json_encode($singleOrder, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)."</pre>";
}else {
    echo "<p>This order realtime data not available</p><br >";
}
echo "</div></div>";