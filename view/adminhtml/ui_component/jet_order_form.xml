<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">jet_order_form.jet_order_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Page Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Magento\Cms\Block\Adminhtml\Page\Edit\SaveButton"/>
            <button name="delete" class="Magento\Cms\Block\Adminhtml\Page\Edit\DeleteButton"/>
            <button name="back" class="Magento\Cms\Block\Adminhtml\Page\Edit\BackButton"/>
        </buttons>
        <namespace>jet_order_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>jet_order_form.jet_order_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="jet_order_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Syedzaidi\JetIntegration\Ui\DataProvider\JetOrderForm\DataProvider</argument>
            <argument name="name" xsi:type="string">jet_order_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">order_id</argument>
            <argument name="requestFieldName" xsi:type="string">order_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="jetintegration/orders/save"/>
        </settings>
    </dataSource>

    <fieldset name="jet_order_details">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="label" xsi:type="string" translate="true">Order Details</item>
                <item name="sortOrder" xsi:type="number">20</item>
            </item>
        </argument>
        <field name="order_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Order Id</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">order_id</item>
                </item>
            </argument>
        </field>
        <field name="alt_order_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Alt Order Id</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">alt_order_id</item>
                </item>
            </argument>
        </field>
        <field name="name">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Buyer Name</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">name</item>
                </item>
            </argument>
        </field>
        <field name="phone_number">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Phone Number</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">phone_number</item>
                </item>
            </argument>
        </field>
        <field name="hash_email">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Email Address</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">hash_email</item>
                </item>
            </argument>
        </field>
        <field name="order_placed_date">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Order Placed Date</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">order_placed_date</item>
                </item>
            </argument>
        </field>
        <field name="status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Status</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">status</item>
                </item>
            </argument>
        </field>
        <field name="tracking_number">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="label" xsi:type="string" translate="true">Tracking Number</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">order</item>
                    <item name="dataScope" xsi:type="string">tracking_number</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
