<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">jet_return_form.jet_return_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Page Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="return-complete" class="Syedzaidi\JetIntegration\Block\Adminhtml\JetReturn\Edit\CompleteButton"/>
            <button name="back" class="\Magento\Cms\Block\Adminhtml\Page\Edit\BackButton"/>
        </buttons>
        <namespace>jet_return_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>jet_return_form.jet_return_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="jet_return_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Syedzaidi\JetIntegration\Ui\DataProvider\JetReturnForm\DataProvider</argument>
            <argument name="name" xsi:type="string">jet_return_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">return_id</argument>
            <argument name="requestFieldName" xsi:type="string">return_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="jetintegration/returns/complete"/>
        </settings>
    </dataSource>

    <fieldset name="jet_return_details">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="label" xsi:type="string" translate="true">Return Information</item>
                <item name="sortOrder" xsi:type="number">20</item>
            </item>
        </argument>
        <field name="return_id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="disabled" xsi:type="boolean">true</item>
                    <item name="label" xsi:type="string" translate="true">Return Id</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">return</item>
                    <item name="dataScope" xsi:type="string">return_id</item>
                </item>
            </argument>
        </field>
        <field name="return_status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">text</item>
                    <item name="disabled" xsi:type="boolean">true</item>
                    <item name="label" xsi:type="string" translate="true">Return Status</item>
                    <item name="formElement" xsi:type="string">input</item>
                    <item name="source" xsi:type="string">return</item>
                    <item name="dataScope" xsi:type="string">return_status</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>