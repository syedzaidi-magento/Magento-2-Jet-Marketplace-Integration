<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="jet_cron_job" instance="Syedzaidi\JetIntegration\Cron\JetCron" method="execute">
            <schedule>* 4 * * *</schedule>
        </job>
        <job name="jet_cron_job_order" instance="Syedzaidi\JetIntegration\Cron\JetCron" method="orders">
            <schedule>30 * * * *</schedule>
        </job>
    </group>
</config>