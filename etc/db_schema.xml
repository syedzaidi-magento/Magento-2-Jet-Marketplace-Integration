<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="jet_marketplace_integration_token" resource="default" engine="innodb"
           comment="jet marketplace integration authorization token">
        <column xsi:type="int" name="token_id" padding="10" unsigned="true" nullable="false" comment="jet token Id"/>
        <column xsi:type="varchar" name="token" nullable="false" length="1024" comment="jet token" />
        <column xsi:type="timestamp" name="time_occurred" comment="Time of event"/>
        <column xsi:type="datetime" name="expires_on" on_update="true" nullable="true" comment="expires on"/>
    </table>
    <table name="jet_integration_product" resource="default" engine="innodb"
           comment="jet marketplace integration product table">
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false" identity="true" comment="jet product Id"/>
        <column xsi:type="varchar" name="merchant_sku" nullable="false" comment="jet product merchant sku" />
        <column xsi:type="varchar" name="sku_created_date" nullable="false" comment="jet product create date" />
        <column xsi:type="varchar" name="sku_last_update" nullable="false" comment="jet product last update" />
        <column xsi:type="varchar" name="status" nullable="false" comment="jet product status" />
        <column xsi:type="timestamp" name="time_occurred" comment="Time of event"/>
        <column xsi:type="datetime" name="expires_on" on_update="true" nullable="true" comment="expires on"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="product_id"/>
        </constraint>
    </table>

    <table name="jet_integration_order" resource="default" engine="innodb"
           comment="jet marketplace integration order table">
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" identity="true" comment="jet order Id"/>
        <column xsi:type="varchar" name="alt_order_id" nullable="false" comment="jet alt order id" />
        <column xsi:type="varchar" name="name" nullable="false" comment="jet buyer name" />
        <column xsi:type="varchar" name="phone_number" nullable="false" comment="jet buyer phone" />
        <column xsi:type="varchar" name="hash_email" nullable="false" comment="jet buyer email" />
        <column xsi:type="varchar" name="order_placed_date" nullable="false" comment="jet order placed date" />
        <column xsi:type="varchar" name="status" nullable="false" comment="jet order status" />
        <column xsi:type="varchar" name="tracking_number" nullable="false" comment="jet order tracking number" />
        <column xsi:type="varchar" name="shipping_carrier" nullable="false" comment="jet order shipping carrier" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
    </table>

    <table name="jet_integration_return" resource="default" engine="innodb"
           comment="jet marketplace integration return table">
        <column xsi:type="int" name="return_id" padding="10" unsigned="true" nullable="false" identity="true" comment="jet return Id"/>
        <column xsi:type="varchar" name="alt_order_id" nullable="false" comment="jet alt order id" />
        <column xsi:type="varchar" name="merchant_order_id" nullable="false" comment="jet merchant order id" />
        <column xsi:type="varchar" name="merchant_return_authorization_id" nullable="false" comment="merchant return authorization id" />
        <column xsi:type="varchar" name="reference_return_authorization_id" nullable="false" comment="jet reference return authorization id" />
        <column xsi:type="varchar" name="return_status" nullable="false" comment="jet return status" />
        <column xsi:type="varchar" name="shipping_carrier" nullable="false" comment="jet shipping carrier" />
        <column xsi:type="varchar" name="tracking_number" nullable="false" comment="jet tracking number" />
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="return_id"/>
        </constraint>
    </table>
</schema>